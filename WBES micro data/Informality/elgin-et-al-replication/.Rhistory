# Load necessary packages
library(readxl)
library(ggplot2)
library(dplyr)
library(zoo)
library(writexl)
# Import data from Excel
data <- read_excel("C:/Users/nicol/Documents/GitHub/Research/H-drive-umn/WBES micro data/Informality/elgin-et-al-replication/pwt-selected-countries.xlsx",
sheet = "Selected Countries")
# View the first few rows of the data
head(data)
#
alpha = 0.36
gamma = 0.425
# compute average depreciation rate by country
average_delta <- data %>%
group_by(country) %>%
summarize(avg_delta = mean(delta, na.rm = TRUE))
# add it as a new column
data <- data %>%
left_join(average_delta, by = "country")
# compute \beta using the Euler equation
data <- data %>%
arrange(country, year) %>%  # Ensure data is sorted by country and year
group_by(country) %>%
mutate(
C_t = rconna,
C_t_minus_1 = lag(rconna),
beta = if_else(!is.na(C_t_minus_1),
(C_t / C_t_minus_1) * (1 / (1 - avg_delta + (1 - csh_g) * alpha * (rgdpna / rnna))),
NA_real_)
) %>%
ungroup()
# compute productivity in the formal sector using the output equation
data <- data %>%
mutate(
prod_formal = rgdpna / (rnna^alpha * emp^(1 - alpha))
)
# compute consumption growth
data <- data %>%
arrange(country, year) %>%  # Ensure data is sorted by country and year
group_by(country) %>%
mutate(
cons_growth = C_t / C_t_minus_1
) %>%
ungroup()
# Assign values of informality for year 2007
# Create a lookup table with the info_share values
info_share_values <- data.frame(
country = c("Bangladesh", "Ghana", "India", "Indonesia", "U.R. of Tanzania: Mainland"),
year = 2007,
info_share = c(34.1, 38.3, 20.7, 17.9, 53.7)
)
# Join the lookup table with the original dataset
data <- data %>%
left_join(info_share_values, by = c("country", "year"))
# compute second term in equation (7) Elgin and Oztunali
data <- data %>%
mutate(
sec_term = (((cons_growth)/beta - 1 + avg_delta)/(alpha*prod_formal*(1-csh_g)))^(alpha/(1-alpha))
)
# compute informal employment (for year 2007)
data <- data %>%
mutate(
emp_info = gamma * (info_share/100) * rgdpna * sec_term / (prod_formal*(1-csh_g)*(1-alpha))
)
# compute productivity informal employment (for year 2007)
data <- data %>%
mutate(
prod_info = (info_share/100 * rgdpna) / (emp_info^gamma)
)
# Step 1: Calculate the growth rates for prod_formal and rnna
data <- data %>%
arrange(country, year) %>%
group_by(country) %>%
mutate(
growth_prod_formal = (prod_formal / lag(prod_formal)) - 1,
growth_rnna = (rnna / lag(rnna)) - 1
) %>%
ungroup()
# Step 2: Calculate the average growth rate
data <- data %>%
mutate(
avg_growth_rate = (growth_prod_formal + growth_rnna) / 2
)
# Step 3: Construct the time series for prod_informal
# Function to fill prod_info for each country for the years after 2007
fill_prod_info_after <- function(df1) {
for (i in 2:nrow(df1)) {
if (!is.na(df1$prod_info[i - 1]) && !is.na(df1$avg_growth_rate[i])) {
df1$prod_info[i] <- df1$prod_info[i - 1] * (1 + df1$avg_growth_rate[i])
}
}
return(df1)
}
# Function to fill prod_info for each country for the years before 2007
fill_prod_info_before <- function(df2) {
for (i in (nrow(df2) - 1):1) {
if (!is.na(df2$prod_info[i + 1]) && !is.na(df2$avg_growth_rate[i + 1])) {
df2$prod_info[i] <- df2$prod_info[i + 1] / (1 + df2$avg_growth_rate[i + 1])
}
}
return(df2)
}
# Apply the functions to each country
data <- data %>%
group_by(country) %>%
group_modify(~ fill_prod_info_after(.x)) %>%
group_modify(~ fill_prod_info_before(.x)) %>%
ungroup()
# calculate informal employmentbased on equation (7) in Elgin and Oztunali
data <- data %>%
mutate(
emp_info = (gamma * prod_info * sec_term / (prod_formal*(1-csh_g)*(1-alpha)))^(1/(1-gamma))
)
# calculate informality shares
data <- data %>%
mutate(
info_share =  100* prod_info * emp_info^gamma / rgdpna
)
df <- as.data.frame(df)
